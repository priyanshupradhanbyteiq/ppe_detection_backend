# PostgreSQL: keep the database name at the end of the URL.
# These local credentials match the Docker example in README.md.
# URL-encode special characters in usernames/passwords (for example, @ as %40).
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ppe_detection

# JWT authentication: replace this value with a randomly generated secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
# Token lifetimes in minutes: 1 day / 7 days.
EXPIRE=1440
REFRESH_EXPIRE=10080

# RabbitMQ: the API and worker must connect to the same broker.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Shared topic exchange for camera commands.
CAMERA_COMMAND_EXCHANGE=camera.commands
DEEPSTREAM_WORKER_NAME=deepstream-default
CAMERA_RECONCILE_SECONDS=10
CAMERA_FRAME_TIMEOUT_SECONDS=30
PPE_OUTBOX_PATH=data/ppe_outbox.sqlite3

# Live camera detail preview: OpenCV -> WebRTC. [] works on localhost/LAN.
# For remote viewers supply your STUN/TURN servers as a JSON array.
# Example: [{"urls":"turn:your-server:3478","username":"viewer","credential":"replace-me"}]
WEBRTC_ICE_SERVERS=[]
WEBRTC_MAX_PEERS=20
WEBRTC_MAX_FPS=20
WEBRTC_MAX_WIDTH=1280
WEBRTC_OPEN_TIMEOUT_SECONDS=5
WEBRTC_READ_TIMEOUT_SECONDS=2
WEBRTC_FIRST_FRAME_TIMEOUT_SECONDS=10
WEBRTC_PEER_IDLE_SECONDS=45

# Frontend origins allowed to open authenticated event-notification WebSockets.
WEBSOCKET_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://localhost:3000"]

# Optional Cloudinary credentials. Leave empty to skip image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
